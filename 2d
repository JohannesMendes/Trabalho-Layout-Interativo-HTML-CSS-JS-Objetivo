@app.route('/')
def home():
    """Página inicial do catálogo"""
    return render_template('index.html', tenis=tenis_database)

@app.route('/marca/<marca>')
def filtrar_por_marca(marca):
    """Filtrar tênis por marca"""
    tenis_filtrados = [t for t in tenis_database if t['marca'].lower() == marca.lower()]
    return render_template('index.html', tenis=tenis_filtrados, marca_selecionada=marca)

@app.route('/categoria/<categoria>')
def filtrar_por_categoria(categoria):
    """Filtrar tênis por categoria"""
    tenis_filtrados = [t for t in tenis_database if t['categoria'].lower() == categoria.lower()]
    return render_template('index.html', tenis=tenis_filtrados, categoria_selecionada=categoria)

@app.route('/produto/<int:produto_id>')
def detalhes_produto(produto_id):
    """Página de detalhes do produto"""
    produto = next((t for t in tenis_database if t['id'] == produto_id), None)
    if produto:
        return render_template('produto.html', produto=produto)
    else:
        return "Produto não encontrado", 404

@app.route('/pesquisar')
def pesquisar():
    """Função de pesquisa"""
    termo = request.args.get('q', '').lower()
    if termo:
        resultados = [
            t for t in tenis_database 
            if termo in t['nome'].lower() or termo in t['marca'].lower()
        ]
        return render_template('index.html', tenis=resultados, termo_pesquisa=termo)
    return render_template('index.html', tenis=tenis_database)

@app.route('/api/tenis')
def api_tenis():
    """API JSON dos tênis"""
    return jsonify(tenis_database)

if __name__ == '__main__':
